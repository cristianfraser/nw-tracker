{
  "name": "nw-tracker-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reads outside data (bank sessions, e-mail, documents) and hands it to the server.",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "fetch:santander": "tsx src/main.ts santander",
    "typecheck": "tsc --noEmit",
    "fetch": "tsx src/main.ts",
    "fetch:racional": "tsx src/main.ts racional",
    "fetch:emails": "tsx src/email/main.ts",
    "fetch:santander-docs": "tsx src/email/santanderDocsMain.ts",
    "fetch:lider-boletas": "tsx src/email/liderBoletasMain.ts",
    "fetch:lider-statements": "tsx src/email/liderStatementsMain.ts",
    "fetch:fintual-docs": "tsx src/email/fintualDocsMain.ts",
    "check:santander-catchup": "tsx src/santanderCatchUpMain.ts",
    "test": "vitest run",
    "import:santander-movements": "tsx src/santander/importCardMovementsMain.ts",
    "service": "tsx src/service/main.ts",
    "import:checking-movements": "tsx src/santander/importCheckingMovementsMain.ts",
    "import:santander-receipts": "tsx src/santander/importPaymentReceiptsMain.ts"
  },
  "dependencies": {
    "imapflow": "1.6.5",
    "nw-tracker-contracts": "0.1.0",
    "playwright-core": "1.62.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
