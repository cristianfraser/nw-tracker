{
  "name": "nw-tracker-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reads outside data (bank sessions, e-mail, documents) and hands it to the server.",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "fetch:santander": "tsx src/main.ts santander",
    "typecheck": "tsc --noEmit",
    "fetch": "tsx src/main.ts",
    "fetch:racional": "tsx src/main.ts racional",
    "fetch:afp-uno": "tsx src/afpUno/fetchMain.ts",
    "fetch:buk-payslips": "tsx src/buk/fetchMain.ts",
    "parse:afp-uno-certificate": "tsx src/afpUno/parseCertificateMain.ts",
    "fetch:emails": "tsx src/email/main.ts",
    "fetch:santander-docs": "tsx src/email/santanderDocsMain.ts",
    "fetch:santander-mail-archive": "tsx src/email/santanderMailArchiveMain.ts",
    "fetch:lider-boletas": "tsx src/email/liderBoletasMain.ts",
    "fetch:lider-statements": "tsx src/email/liderStatementsMain.ts",
    "fetch:fintual-docs": "tsx src/email/fintualDocsMain.ts",
    "fetch:apple-mail": "tsx src/email/appleMailMain.ts",
    "check:santander-catchup": "tsx src/santanderCatchUpMain.ts",
    "test": "vitest run",
    "import:santander-movements": "tsx src/santander/importCardMovementsMain.ts",
    "import:santander-statements": "tsx src/santander/importStatementsMain.ts",
    "import:cc-statements": "tsx src/cards/importParsedStatementsMain.ts",
    "organize:inbox": "PYTHONPATH=python/.pdf_deps python3 python/organize-cfraser-statement-pdfs.py",
    "repair:cc-pdfs-qpdf": "PYTHONPATH=python/.pdf_deps python3 python/repair-cc-statement-pdfs-qpdf.py",
    "restore:cc-corrupt-pdfs": "PYTHONPATH=python/.pdf_deps python3 python/restore-cc-corrupt-pdfs.py",
    "parse:cc-pdfs": "PYTHONPATH=python/.pdf_deps python3 python/parse-cc-statement-pdfs.py",
    "parse:checking-cartola-pdfs": "PYTHONPATH=python/.pdf_deps python3 python/parse-checking-cartola-pdfs.py",
    "parse:cuenta-vista-cartola-pdfs": "PYTHONPATH=python/.pdf_deps python3 python/parse-cuenta-vista-cartola-pdfs.py",
    "organize:checking-cartola-xlsx": "tsx src/santander/organizeCheckingCartolaXlsxMain.ts",
    "import:checking-cartolas": "tsx src/santander/importCartolasMain.ts --account=checking",
    "import:cuenta-vista-cartolas": "tsx src/santander/importCartolasMain.ts --account=cuenta-vista",
    "check:cc-parse": "PYTHONPATH=python/.pdf_deps python3 python/check-cc-statement-parse.py",
    "test:python": "cd python && for t in *_test.py; do PYTHONPATH=.pdf_deps python3 \"$t\" || exit 1; done",
    "service": "tsx src/service/main.ts",
    "import:checking-movements": "tsx src/santander/importCheckingMovementsMain.ts",
    "import:santander-receipts": "tsx src/santander/importPaymentReceiptsMain.ts",
    "import:apple-mail": "tsx src/apple/importMain.ts",
    "check:broker-emails": "tsx src/brokers/checkBrokerEmailsMain.ts",
    "import:fintual-emails": "tsx src/brokers/importBrokerEmailsMain.ts --broker=fintual",
    "import:racional-emails": "tsx src/brokers/importBrokerEmailsMain.ts --broker=racional",
    "import:racional-movements": "tsx src/racional/importReadsMain.ts",
    "import:grocery-receipts": "tsx src/grocery/importReceiptsMain.ts",
    "parse:grocery-receipts": "python3 python/parse-grocery-receipts.py",
    "parse:payroll-liquidaciones": "PYTHONPATH=python/.pdf_deps python3 python/parse-payroll-liquidaciones.py",
    "import:payroll-liquidaciones": "tsx src/payroll/importPayslipsMain.ts",
    "import:fintual-acciones": "tsx src/fintual/importAccionesMain.ts",
    "import:fintual-cert": "tsx src/fintual/importCertMain.ts",
    "import:afc-cert": "tsx src/afc/importDocumentsMain.ts",
    "server-task": "tsx src/serverTaskMain.ts",
    "import:cfraser-inbox": "tsx src/inbox/pipelineMain.ts"
  },
  "dependencies": {
    "imapflow": "1.6.5",
    "nw-tracker-contracts": "0.1.0",
    "playwright-core": "1.62.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
