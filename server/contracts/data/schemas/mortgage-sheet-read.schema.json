    "document": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modified_at": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "name",
        "sha256",
        "size",
        "modified_at"
      ],
      "additionalProperties": false
    },
    "sheet": {
      "type": "string"
    },
    "table": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "pie",
              "prepago",
              "cuota"
            ]
          },
          "label": {
            "type": "string",
