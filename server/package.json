{
  "name": "nw-tracker-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "serve": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "migrate": "tsx -e \"import './src/db.ts'\"",
    "backfill:generic-transfer-unique": "tsx -e \"import { backfillGenericTransferUniquePurchases } from './src/ccExpenseGenericTransferBackfill.ts'; console.log(backfillGenericTransferUniquePurchases())\"",
    "backfill:checking-auto-match-categories": "tsx -e \"import { backfillCheckingAutoMatchCategories } from './src/backfillCheckingAutoMatchCategories.ts'; console.log(backfillCheckingAutoMatchCategories())\"",
    "repair:cc-metadata": "tsx scripts/repair-cc-statement-metadata.ts",
    "repair:cc-web-paste-pdf-reconcile": "tsx scripts/repair-cc-web-paste-pdf-reconcile.ts",
    "repair:cc-source-pdf": "tsx scripts/repair-cc-statement-source-pdf-names.ts",
    "list:missing-cc-pdfs": "tsx scripts/list-missing-cc-statement-pdfs.ts",
    "db:snapshot": "tsx scripts/db-snapshot.ts",
    "db:prune-snapshots": "tsx scripts/prune-db-snapshots.ts",
    "demo:generate": "tsx scripts/generate-demo-data.ts --market-asset",
    "demo:generate:fetch": "tsx scripts/generate-demo-data.ts --real-market",
    "demo:publish-market": "rm -f data/demo-market-publish.db data/demo-market-publish.db-wal data/demo-market-publish.db-shm && NW_TRACKER_TEST_DB=demo-market-publish.db tsx scripts/publish-demo-market.ts",
    "demo:visits": "tsx scripts/print-demo-visits.ts",
    "demo:refresh-santiago-snapshot": "tsx scripts/refresh-demo-santiago-snapshot.ts",
    "repair:cc-usd-statements": "tsx scripts/import-missing-cc-usd-statements.ts",
    "reconcile:real-estate-links": "tsx scripts/reconcile-real-estate-expense-links.ts",
    "reconcile:cartola-partials": "tsx scripts/reconcile-cartola-partials.ts",
    "import:cc-parsed": "tsx scripts/import-cc-parsed-to-db.ts",
    "wipe:cartola-ledger": "tsx scripts/wipe-cartola-ledger.ts",
    "repair:cc-installment-duplicate-purchases": "tsx scripts/repair-cc-installment-duplicate-purchases.ts",
    "backfill:cc-valuations-from-ledger": "tsx scripts/backfill-cc-valuations-from-installment-ledger.ts",
    "fetch-uf": "tsx scripts/fetch-sii-uf-daily.ts",
    "fintual:backfill-cert-fund-units": "tsx scripts/fintual-backfill-cert-fund-units.ts",
    "nav:reseed": "tsx -e \"import { seedNavTree } from './src/seedNavTree.ts'; seedNavTree();\"",
    "sync:all": "tsx scripts/global-sync.ts",
    "sync:fintual-rn-composition": "tsx scripts/sync-fintual-rn-composition.ts",
    "live-quotes:sync": "tsx scripts/sync-live-quotes.ts",
    "equity:record-split": "tsx scripts/record-equity-split.ts",
    "backfill:sbif-utm-ipc": "tsx scripts/backfill-sbif-utm-ipc.ts",
    "backfill:sbif-fx-eur": "tsx scripts/backfill-sbif-fx-eur-daily.ts",
    "backfill:yahoo-fx-usd": "tsx scripts/backfill-yahoo-fx-usd.ts",
    "backfill:fx-bid-ask-from-movements": "tsx scripts/backfill-fx-bid-ask-from-movements.ts",
    "backfill:crypto-coingecko-eod": "tsx scripts/backfill-crypto-coingecko-eod.ts",
    "backfill:bolsa-santiago-eod": "tsx scripts/backfill-bolsa-santiago-eod.ts",
    "backfill:bcentral-uf": "tsx scripts/backfill-bcentral-uf.ts",
    "backfill:afc-cic": "tsx scripts/backfill-afc-cic.ts",
    "afc:derive-cuotas": "tsx scripts/afc-cuota-ledger-derive.ts",
    "backfill:watchlist-equity-history": "tsx scripts/backfill-watchlist-equity-history.ts",
    "register:market-symbols": "tsx scripts/register-market-symbols.ts",
    "backfill:equity-dividends": "tsx scripts/backfill-equity-dividends.ts",
    "probe:bcentral-series": "tsx scripts/probe-bcentral-series.ts",
    "sync:equity-eod": "tsx scripts/sync-equity-eod.ts",
    "prune:future-month-end-valuations": "tsx scripts/prune-future-month-end-valuations.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && NW_TRACKER_TEST_DB=nw-tracker.test.db vitest run",
    "profile:dashboard": "tsx scripts/profile-dashboard.ts",
    "db:verify-backup": "tsx scripts/verify-db-backup.ts",
    "match:app-store-notes": "tsx scripts/match-app-store-notes.ts"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "nw-tracker-contracts": "0.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "zod": "4.4.3"
  }
}
